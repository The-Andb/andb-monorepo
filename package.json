{
  "name": "the-andb",
  "private": true,
  "workspaces": [
    "ui",
    "core",
    "cli",
    "landing"
  ],
  "dependencies": {
    "ssh2": "^1.15.0"
  },
  "scripts": {
    "dev:ui": "npm run electron:dev --workspace=ui",
    "dev:cli": "npm run dev --workspace=cli",
    "dev:landing": "npm run dev --workspace=landing",
    "build:core": "npm run build --workspace=core",
    "build:ui": "npm run build --workspace=ui",
    "build:landing": "npm run build --workspace=landing",
    "build:all": "npm run build:core && npm run build:ui && npm run build:landing",
    "ui:prod": "npm run test:prod --workspace=ui",
    "ui:package": "npm run electron:build --workspace=ui",
    "ui:publish": "npm run electron:publish --workspace=ui",
    "test": "npm test --workspaces",
    "test:ui": "npm run test:ui --workspace=ui",
    "test:e2e": "npm run test:e2e --workspace=ui",
    "test:core": "npm test --workspace=core"
  }
}