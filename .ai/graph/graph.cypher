CREATE (:Method {id: "method:BaseStorageStrategy.getDdlExports", name: "getDdlExports", description: "Queries DdlExportEntity rows, then rehydrates ddl_content per row by reading file_path via _readSqlFile; on read failure silently leaves ddl_content as '' (was already fixed to at least log a warning — see issue:ddl-rehydrate-fallback)", file: "andb-core/src/modules/storage/strategy/base-storage.strategy.ts", line: 732, language: "ts", tags: ["storage", "export", "compare"], updatedAt: "2026-07-28"});
CREATE (:Method {id: "method:BaseStorageStrategy._readSqlFile", name: "_readSqlFile", description: "Resolves a stored relative file_path to an absolute path across a long chain of fallbacks (primary path, project-scoped path, multi-format legacy/modern path reconstruction) and reads the DDL .sql file. FIXED 2026-07-28: removed the fallback that scanned every sibling project directory for a same-named file (could return a different project's DDL), and removed blind cross-engine guessing (mysql/postgres/sqlite/oracle/mssql) when the encoded engine was unknown — now only guesses 'mysql' for pre-multi-engine legacy paths. Total lookup failure now always logs a warning instead of failing silently.", file: "andb-core/src/modules/storage/strategy/base-storage.strategy.ts", line: 434, language: "ts", tags: ["storage", "export", "compare", "fixed"], updatedAt: "2026-07-28"});
CREATE (:BusinessRule {id: "issue:ddl-rehydrate-fallback", name: "DDL rehydrate cross-project/cross-engine leakage + silent empty content", description: "FIXED 2026-07-28 (safe-fix approach): root cause of \"export lắm lúc không thể hiện đúng trạng thái DDL\". saveDdlExport() always clears ddl_content from the SQLite row after writing it to a .sql file; every read rehydrates from file_path via _readSqlFile(). When the exact expected path was stale (e.g. after a project rename, or projectBaseDir/activeProjectName drift), _readSqlFile fell back to (a) scanning every OTHER project's folder for a same-named file, and (b) guessing across 5 different DB engines — both could return a completely different schema's DDL, or find nothing and silently return '' (shown to the user as an empty/missing DDL for an object that actually has content). Fix removed both dangerous fallbacks and added a non-debug-gated warning log on total lookup failure, so failures are now visible instead of silently wrong.", file: "andb-core/src/modules/storage/strategy/base-storage.strategy.ts", line: 434, language: "ts", tags: ["fixed", "export", "accuracy", "storage"], updatedAt: "2026-07-28"});
CREATE (:BusinessRule {id: "issue:semantic-diff-single-table", name: "SemanticDiff single-table assumption", description: "FIXED 2026-07-28: SemanticDiffService.compare used to only inspect the first statement in each astified DDL (sourceAst[0]/targetAst[0]), silently truncating multi-table DDL to one table. Now loops over all CREATE-TABLE statements on both sides, diffs matching tables by name, and reports added/dropped tables. Regression-covered by semantic-diff.service.spec.ts.", file: "andb-core/src/modules/comparator/semantic-diff.service.ts", line: 26, language: "ts", tags: ["fixed", "compare", "accuracy"], updatedAt: "2026-07-28"});
CREATE (:BusinessRule {id: "issue:comparator-diff-placeholder", name: "Comparator terminal diff is a placeholder", description: "logDiff()/_logDetailedDiff() do basic string logging instead of using a real diff algorithm/library, per inline comment 'In a real terminal we'd use diff or a library. For now, basic logging.' Can misrepresent line-level DDL differences to the user.", file: "andb-core/src/modules/comparator/comparator.service.ts", line: 1126, language: "ts", tags: ["known-issue", "compare", "accuracy"], updatedAt: "2026-07-28"});

